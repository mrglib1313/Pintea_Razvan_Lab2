@page "{id:int?}"
@model Pintea_Razvan_Lab2.Pages.PublishersPages.IndexModel

@{
    ViewData["Title"] = "Publishers";
}

<h1>Publishers</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Publisher Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Publishers)
        {
            <tr class="@(item.ID == Model.PublisherID ? "table-success" : "")">
                <td>@item.PublisherName</td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.PublisherData.Books != null)
{
    <h3>Books Edited by Selected Publisher</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.PublisherData.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>
                        @(book.Authors == null
                            ? ""
                            : book.Authors.FullName)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
