
@page "/"
@model Pintea_Razvan_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Books</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Title)
            </th>
            <th>
                Author
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].PublishingDate)
            </th>
<th>
 @Html.DisplayNameFor(model => model.Book[0].BookCategories)
 </th>
            <th>
                Publisher
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.BookD.Books) {
        string selectedRow = "";
        if (item.ID == Model.BookID)
        {
            selectedRow = "table-success";
        }
        <tr class="@selectedRow">
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
                <td>
                    @(item.Authors == null
                        ? ""
                        : $"{item.Authors.FirstName} {item.Authors.LastName}")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>
            <td>
                @(item.Publisher == null ? "" : item.Publisher.PublisherName)
            </td>
            <td>
                @if (item.BookCategories != null)
                {
                    foreach (var category in item.BookCategories)
                    {
                        <text>@category.Category.ID @category.Category.CategoryName<br /></text>
                    }
                }
            </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

