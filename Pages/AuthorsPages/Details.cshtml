@page
@model Pintea_Razvan_Lab2.Pages.AuthorsPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Authors</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Authors.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Authors.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Authors.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Authors.LastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Authors.Books)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Authors.Books)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Authors.FullName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Authors.FullName)
        </dd>

        <dt class="col-sm-2">Categories</dt>
        <dd class="col-sm-10">
            @if (Model.Authors.Books != null && Model.Authors.Books.Any(b => b.BookCategories != null && b.BookCategories.Any()))
            {
                foreach (var book in Model.Authors.Books)
                {
                    if (book.BookCategories != null)
                    {
                        foreach (var bc in book.BookCategories)
                        {
                            <div>@bc.Category.CategoryName</div>
                        }
                    }
                }
            }
            else
            {
                <span>No categories assigned</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Authors.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>