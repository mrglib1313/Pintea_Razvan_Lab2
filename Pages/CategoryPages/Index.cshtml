@page
@model Pintea_Razvan_Lab2.Pages.CategoryPages.IndexModel
@using Pintea_Razvan_Lab2.Models

<h1>Categories</h1>

<table class="table">
    <thead>
        <tr>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model.Category)
        {
            <tr>
                <td>
                    <a asp-page="./Index" asp-route-id="@category.ID">
                        @category.CategoryName
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.SelectedCategory != null)
{
    <h2>Books in category: @Model.SelectedCategory.CategoryName</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bookCategory in Model.SelectedCategory.BookCategories
                ?? Enumerable.Empty<BookCategory>())
            {
                <tr>
                    <td>@bookCategory.Book.Title</td>
                    <td>
                        @(bookCategory.Book.Authors == null
                            ? ""
                            : $"{bookCategory.Book.Authors.FirstName} {bookCategory.Book.Authors.LastName}")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-page="./Index">Show all categories</a>
}
